-- Hàm tạo Highlight chung
local function applyHighlight(target, color, name)
    if not target:FindFirstChild(name) then
        local hl = Instance.new("Highlight")
        hl.Name = name
        hl.Adornee = target
        hl.FillColor = color
        hl.FillTransparency = 0.5
        hl.OutlineColor = Color3.fromRGB(255, 255, 255)
        hl.OutlineTransparency = 0
        hl.Parent = target
    end
end

local function removeHighlight(target, name)
    local hl = target:FindFirstChild(name)
    if hl then
        hl:Destroy()
    end
end

-- Vòng lặp chính xử lý ESP, Tốc độ và Trọng lực
RunService.RenderStepped:Connect(function()
    -- 1. Xử lý ESP Nextbot (Màu Đỏ)
    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA("Model") then
            local isPlayerChar = Players:GetPlayerFromCharacter(obj) ~= nil
            
            if Config.EspNextbot then
                if not isPlayerChar and obj ~= LocalPlayer.Character and (obj:FindFirstChild("Humanoid") or obj:FindFirstChild("Sound")) then
                    if obj:FindFirstChild("HumanoidRootPart") or obj.PrimaryPart then
                        applyHighlight(obj, Color3.fromRGB(255, 0, 0), "NextbotESP")
                    end
                end
            else
                removeHighlight(obj, "NextbotESP")
            end
            
            -- 2. Xử lý ESP Người chơi (Màu Xanh Dương)
            if Config.EspPlayer then
                if isPlayerChar and obj ~= LocalPlayer.Character then
                    applyHighlight(obj, Color3.fromRGB(0, 150, 255), "PlayerESP")
                end
            else
                removeHighlight(obj, "PlayerESP")
            end
            
            -- 3. Xử lý ESP Vật phẩm / Mục tiêu nhiệm vụ (Màu Vàng)
            if Config.EspItem then
                if obj.Name:lower():find("item") or obj.Name:lower():find("objective") or obj.Name:lower():find("pickup") or obj.Name:lower():find("soda") then
                    applyHighlight(obj, Color3.fromRGB(255, 220, 0), "ItemESP")
                end
            else
                removeHighlight(obj, "ItemESP")
            end
        end
    end
    
    -- Xử lý tốc độ chạy không giới hạn
    if Config.SpeedEnabled then
        local char = LocalPlayer.Character
        if char and char:FindFirstChild("Humanoid") then
            char.Humanoid.WalkSpeed = Config.CustomSpeed
        end
    end
    
    -- Xử lý trọng lực thế giới không giới hạn
    if Config.GravityEnabled then
        workspace.Gravity = Config.CustomGravity
    end
end)

