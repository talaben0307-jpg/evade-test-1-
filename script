local function applyHighlight(target, color, name)
    if not target:FindFirstChild(name) then
        local hl = Instance.new("Highlight")
        hl.Name = name
        hl.Adornee = target
        hl.FillColor = color
        hl.FillTransparency = 0.5
        hl.OutlineColor = Color3.fromRGB(255, 255, 255)
        hl.OutlineTransparency = 0
        hl.Parent = target
    end
end

local function removeHighlight(target, name)
    local hl = target:FindFirstChild(name)
    if hl then
        hl:Destroy()
    end
end

-- Tối ưu hóa vòng lặp chạy thưa hơn để giảm lag
local timer = 0
RunService.RenderStepped:Connect(function(dt)
    timer = timer + dt
    if timer < 0.2 then return end -- Chỉ quét mỗi 0.2 giây thay vì quét liên tục mỗi khung hình
    timer = 0

    -- 1. ESP Người chơi
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character then
            if Config.EspPlayer then
                applyHighlight(player.Character, Color3.fromRGB(0, 150, 255), "PlayerESP")
            else
                removeHighlight(player.Character, "PlayerESP")
            end
        end
    end

    -- 2. Quét tối ưu trong workspace (Giảm phạm vi tìm kiếm)
    local activeFolder = workspace:FindFirstChild("Active") or workspace
    for _, obj in ipairs(activeFolder:GetChildren()) do
        if obj:IsA("Model") then
            local isPlayerChar = Players:GetPlayerFromCharacter(obj) ~= nil
            
            if Config.EspNextbot then
                if not isPlayerChar and (obj:FindFirstChild("Humanoid") or obj:FindFirstChild("Sound")) then
                    applyHighlight(obj, Color3.fromRGB(255, 0, 0), "NextbotESP")
                end
            else
                removeHighlight(obj, "NextbotESP")
            end
            
            if Config.EspItem then
                local lname = obj.Name:lower()
                if lname:find("item") or lname:find("objective") or lname:find("pickup") or lname:find("soda") or lname:find("medkit") then
                    applyHighlight(obj, Color3.fromRGB(255, 220, 0), "ItemESP")
                end
            else
                removeHighlight(obj, "ItemESP")
            end
        end
    end
    
    if Config.SpeedEnabled then
        local char = LocalPlayer.Character
        if char and char:FindFirstChild("Humanoid") then
            char.Humanoid.WalkSpeed = Config.CustomSpeed
        end
    end
    
    if Config.GravityEnabled then
        workspace.Gravity = Config.CustomGravity
    end
end)

